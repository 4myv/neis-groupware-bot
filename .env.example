# ------------------------------------------------------------
# .env.example: .env 파일에 어떤 항목을 적어야 하는지 보여 주는 견본
# 이 파일에는 '항목 이름'만 적는다. 실제 값은 절대 적지 않는다.
#
# 사용 방법
#   1) 이 파일을 복사해서 .env 파일을 만든다.
#      PowerShell 명령: Copy-Item .env.example .env
#   2) .env 파일을 열어 각 줄의 = 뒤에 실제 값을 적는다. (따옴표와 띄어쓰기 없이)
#   3) .env 파일은 .gitignore에 들어 있어서 GitHub에 올라가지 않는다.
# ------------------------------------------------------------

# [NEIS] 나이스 교육정보 개방 포털에서 발급받은 인증키 (2단계부터 사용)
NEIS_API_KEY=

# [Slack] 앱 설정 화면 > OAuth & Permissions > OAuth Tokens 에 있는 봇 토큰
# xoxb- 로 시작한다. (4단계부터 사용)
SLACK_BOT_TOKEN=

# [Slack] 앱 설정 화면 > Basic Information 에 있는 Signing Secret
# 7단계(서명 검증)부터 사용
SLACK_SIGNING_SECRET=
