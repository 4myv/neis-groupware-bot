# ------------------------------------------------------------
# .env.example: .env 파일에 어떤 항목을 적어야 하는지 보여 주는 견본
# 이 파일에는 '항목 이름'만 적는다. 실제 값은 절대 적지 않는다.
#
# 사용 방법
#   1) 이 파일을 복사해서 .env 파일을 만든다.
#      PowerShell 명령: Copy-Item .env.example .env
#   2) .env 파일을 열어 각 줄의 = 뒤에 실제 값을 적는다. (따옴표와 띄어쓰기 없이)
#   3) .env 파일은 .gitignore에 들어 있어서 GitHub에 올라가지 않는다.
# ------------------------------------------------------------

# [NEIS] 나이스 교육정보 개방 포털에서 발급받은 인증키 (2단계부터 사용)
NEIS_API_KEY=

# [NEIS] 급식을 조회할 학교의 코드 (2단계에서 python find_school.py로 찾는다)
# 시도교육청코드: 결과의 ATPT_OFCDC_SC_CODE 값 (예: 서울특별시교육청은 B10)
NEIS_OFFICE_CODE=
# 행정표준코드: 결과의 SD_SCHUL_CODE 값
NEIS_SCHOOL_CODE=

# [Slack] 앱 설정 화면 > OAuth & Permissions > OAuth Tokens 에 있는 봇 토큰
# xoxb- 로 시작한다. 4단계에서 setup_slack_token.py가 한 번만 교환에 쓴다.
# 교환한 뒤의 토큰은 secrets/slack_tokens.json에 저장된다.
SLACK_BOT_TOKEN=

# [Slack] 앱 설정 화면 > Basic Information > App Credentials (4단계부터 사용, 토큰 교환·재발급)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# [Slack] 앱 설정 화면 > Basic Information 에 있는 Signing Secret
# 7단계(서명 검증)부터 사용
SLACK_SIGNING_SECRET=

# [Slack] 채널 ID (브라우저에서 채널을 열었을 때 주소 끝의 C로 시작하는 부분)
# 급식 알림을 보낼 채널 (4단계부터 사용)
SLACK_CHANNEL_ID=
# 오류 알림을 받을 관리자 채널 (5단계부터 사용)
SLACK_ADMIN_CHANNEL_ID=
